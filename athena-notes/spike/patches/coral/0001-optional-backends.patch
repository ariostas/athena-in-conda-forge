-if(NOT WIN32)
+# Optional backends, so that CORAL can be built without externals that are not
+# available or not redistributable (e.g. the Oracle Instant Client).
+option(CORAL_BUILD_MYSQL "Build the MySQL backend" ON)
+option(CORAL_BUILD_ORACLE "Build the Oracle backend" ON)
+option(CORAL_BUILD_FRONTIER "Build the Frontier backend" ON)
+option(CORAL_BUILD_TESTS "Build the tests" ON)
+option(CORAL_BUILD_SERVER "Build the CORAL server" ON)
+if(CORAL_BUILD_MYSQL)
+  list(APPEND subdirs MySQLAccess)
+endif()
+if(CORAL_BUILD_ORACLE)
+  list(APPEND subdirs OracleAccess)
+endif()
+if(CORAL_BUILD_TESTS)
+  list(APPEND subdirs Tests)
+endif()
+
+if(NOT WIN32 AND CORAL_BUILD_FRONTIER)
   set(subdirs ${subdirs} FrontierAccess)
 endif()

 # CORAL SERVER subdirectories
-IF(NOT CMAKE_HOST_SYSTEM_NAME MATCHES "Darwin") # CORALCOOL-2822
