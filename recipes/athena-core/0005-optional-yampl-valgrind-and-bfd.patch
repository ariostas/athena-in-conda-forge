Packages of the core layer with externals that are not available everywhere (macOS: yampl is
Linux only, and conda-forge has no valgrind or binutils' libbfd there):
- AthenaServices and AthenaMPTools: the event service's event loop manager
  (AthenaMtesEventLoopMgr) and event range tools (EvtRangeScatterer, EvtRangeProcessor) are
  left out when yampl is not found;
- TimeoutAlg checks whether it runs on valgrind only when valgrind's header exists;
- AthenaAuditors: the FPE auditor of x86_64 Linux uses bfd (and libiberty) only when they are
  found, and is the portable one otherwise (conda-forge's binutils has no libiberty);
- AthenaMPTools links librt (part of the C library elsewhere) on Linux only.

--- a/Control/AthenaServices/CMakeLists.txt
+++ b/Control/AthenaServices/CMakeLists.txt
@@ -14,10 +14,25 @@
 find_package( UUID )
 find_package( yampl )
 find_package( valgrind ) # Note that there is no VALGRIND_LIBRARIES variable.
+if( NOT VALGRIND_FOUND )
+   # (no valgrind, e.g. on macOS: TimeoutAlg does without its header)
+   set( VALGRIND_INCLUDE_DIRS )
+endif()
 
-# Component(s) in the package:
+# Component(s) in the package. The event service's event loop manager needs yampl, which is
+# Linux only.
+set( _sources src/*.h src/*.cxx src/components/*.cxx )
+set( _definitions )
+if( NOT YAMPL_FOUND )
+   file( GLOB _sources src/*.h src/*.cxx src/components/*.cxx )
+   list( FILTER _sources EXCLUDE REGEX "AthenaMtesEventLoopMgr" )
+   set( _definitions DEFINITIONS -DATHENASERVICES_NO_YAMPL )
+   set( YAMPL_INCLUDE_DIRS )
+   set( YAMPL_LIBRARIES )
+endif()
 atlas_add_component( AthenaServices
-   src/*.h src/*.cxx src/components/*.cxx
+   ${_sources}
+   ${_definitions}
    INCLUDE_DIRS  ${Python_INCLUDE_DIRS}
    ${CLHEP_INCLUDE_DIRS} ${ROOT_INCLUDE_DIRS} ${TBB_INCLUDE_DIRS} ${UUID_INCLUDE_DIRS} ${YAMPL_INCLUDE_DIRS}
    ${VALGRIND_INCLUDE_DIRS} ${EIGEN_INCLUDE_DIRS}
