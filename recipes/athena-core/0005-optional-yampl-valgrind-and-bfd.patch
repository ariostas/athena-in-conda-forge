--- a/Control/AthenaAuditors/CMakeLists.txt
+++ b/Control/AthenaAuditors/CMakeLists.txt
@@ -6,11 +6,20 @@
 # External dependencies:
 find_package( gdb COMPONENTS bfd iberty sframe )
 find_package( ZLIB )
+# bfd (with libiberty) only for the FPE auditor of x86_64 Linux. Without all of it (conda-forge's
+# binutils has no libiberty; macOS has none of it) that auditor is the portable one.
+set( _definitions )
+if( NOT "${GDB_LIBRARIES}" MATCHES "libbfd" OR NOT "${GDB_LIBRARIES}" MATCHES "libiberty" OR
+    NOT GDB_INCLUDE_DIRS OR "${GDB_INCLUDE_DIRS}" MATCHES "NOTFOUND" )
+   set( GDB_INCLUDE_DIRS )
+   set( GDB_LIBRARIES )
+   set( _definitions ATHENAAUDITORS_NO_BFD )
+endif()
 
 # Component(s) in the package:
 atlas_add_component( AthenaAuditors
    src/*.h src/*.cxx src/components/*.cxx
-   DEFINITIONS PACKAGE=AthenaAuditors  # needed by bfd.h
+   DEFINITIONS PACKAGE=AthenaAuditors ${_definitions}  # PACKAGE: needed by bfd.h
    INCLUDE_DIRS ${GDB_INCLUDE_DIRS} ${ZLIB_INCLUDE_DIRS}
    # zstd may be needed by libbfd
    LINK_LIBRARIES ${GDB_LIBRARIES} ${ZLIB_LIBRARIES} zstd AthenaBaseComps CxxUtils GaudiKernel )
