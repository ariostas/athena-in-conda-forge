diff --git a/GaudiPluginService/python/GaudiPluginService/cpluginsvc.py b/GaudiPluginService/python/GaudiPluginService/cpluginsvc.py
index 4de1367..cff3d51 100644
--- a/GaudiPluginService/python/GaudiPluginService/cpluginsvc.py
+++ b/GaudiPluginService/python/GaudiPluginService/cpluginsvc.py
@@ -53,6 +53,19 @@ def _get_filename():
         "Windows": "libGaudiPluginService.dll",
         "Linux": "libGaudiPluginService.so",
     }[name]
+    if name == "Darwin":
+        # dyld does not look in LD_LIBRARY_PATH, and System Integrity Protection drops
+        # DYLD_LIBRARY_PATH from the environment of any script started through /usr/bin/env:
+        # look for the library in both, and in this python installation's prefix
+        import os
+        import sys
+
+        dirs = os.environ.get("DYLD_LIBRARY_PATH", "").split(":")
+        dirs += os.environ.get("LD_LIBRARY_PATH", "").split(":")
+        dirs.append(os.path.join(sys.prefix, "lib"))
+        for d in dirs:
+            if d and os.path.isfile(os.path.join(d, fname)):
+                return os.path.join(d, fname)
     return fname
 
 
