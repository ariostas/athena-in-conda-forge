diff --git a/Build/AtlasLCG/modules/FindPython.cmake b/Build/AtlasLCG/modules/FindPython.cmake
index 4d7254b..0265c79 100644
--- a/Build/AtlasLCG/modules/FindPython.cmake
+++ b/Build/AtlasLCG/modules/FindPython.cmake
@@ -28,6 +28,23 @@ endif()
 
 lcg_wrap_find_module( Python )
 
+# On macOS, link libpython only into executables. A library or module that links it, loaded into
+# an interpreter that has libpython built in (conda-forge's python does), runs against a second,
+# uninitialised copy of it, as macOS resolves symbols by library (two-level namespace). They
+# look the symbols up in the process at run time instead, as python extension modules do.
+if( APPLE AND Python_LIBRARIES AND NOT Python_LIBRARIES MATCHES "dynamic_lookup" )
+   set( _isExe "$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>" )
+   set( _libraries )
+   foreach( _lib ${Python_LIBRARIES} )
+      list( APPEND _libraries "$<${_isExe}:${_lib}>" )
+   endforeach()
+   list( APPEND _libraries "$<$<NOT:${_isExe}>:-Wl,-undefined,dynamic_lookup>" )
+   set( Python_LIBRARIES ${_libraries} )
+   unset( _isExe )
+   unset( _libraries )
+   unset( _lib )
+endif()
+
 # Cache some additional variables.
 if ( Python_FOUND )
    set( Python_VERSION_MAJOR "${Python_VERSION_MAJOR}" CACHE INTERNAL
