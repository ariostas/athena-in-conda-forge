From 9b7eebe12c620f6d81bdb72ceb5809c444f73710 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@wisc.edu>
Date: Fri, 25 Sep 2026 21:20:01 -0600
Subject: [PATCH] fix: Don't require libpython to build the Python extension
 module

AX_PYTHON_DEVEL's final "consistency of all components of python
development environment" check links a test program calling
Py_Initialize() against PYTHON_LIBS (-lpython3.X). That is an *embedding*
check, and Rivet does not embed Python: pyext/build.py builds a plain
extension module, which resolves Python symbols at runtime from the
interpreter. None of PYTHON_LIBS, PYTHON_EXTRA_LIBS or
PYTHON_EXTRA_LDFLAGS is used by any build rule; they appear only in
automake's generated Makefile.in boilerplate, so this check is their
sole consumer.

From CPython 3.15 onwards a shared libpython is no longer guaranteed to
be installed next to the headers, so the link test now fails on setups
where the extension module builds and runs perfectly well:

  checking for Python library path... -L<prefix>/lib -lpython3.15
  checking consistency of all components of python development environment... no
  configure: error:
    Could not link test program to Python. [...]

Make the check compile-only so that it validates what Rivet actually
needs - usable Python headers - without demanding a library it never
links.
---
 m4/ax_python_devel.m4 | 20 +++++++++-----------
 1 file changed, 9 insertions(+), 11 deletions(-)

diff --git a/m4/ax_python_devel.m4 b/m4/ax_python_devel.m4
index 0f1ea2a..0c07e29 100644
--- a/m4/ax_python_devel.m4
+++ b/m4/ax_python_devel.m4
@@ -352,33 +352,31 @@ EOD`
 	#
 	# final check to see if everything compiles alright
 	#
+	# Compile-only on purpose: Rivet builds an extension module, which resolves
+	# Python symbols at runtime and never links libpython. A link test would
+	# instead probe the ability to *embed* Python, which fails wherever no
+	# shared libpython is installed next to the headers (e.g. CPython 3.15).
 	AC_MSG_CHECKING([consistency of all components of python development environment])
 	# save current global flags
-	ac_save_LIBS="$LIBS"
-	ac_save_LDFLAGS="$LDFLAGS"
 	ac_save_CPPFLAGS="$CPPFLAGS"
-	LIBS="$ac_save_LIBS $PYTHON_LIBS $PYTHON_EXTRA_LIBS $PYTHON_EXTRA_LIBS"
-	LDFLAGS="$ac_save_LDFLAGS $PYTHON_EXTRA_LDFLAGS"
 	CPPFLAGS="$ac_save_CPPFLAGS $PYTHON_CPPFLAGS"
 	AC_LANG_PUSH([C])
-	AC_LINK_IFELSE([
+	AC_COMPILE_IFELSE([
 		AC_LANG_PROGRAM([[#include <Python.h>]],
 				[[Py_Initialize();]])
 		],[pythonexists=yes],[pythonexists=no])
 	AC_LANG_POP([C])
 	# turn back to default flags
 	CPPFLAGS="$ac_save_CPPFLAGS"
-	LIBS="$ac_save_LIBS"
-	LDFLAGS="$ac_save_LDFLAGS"
 
 	AC_MSG_RESULT([$pythonexists])
 
         if test ! "x$pythonexists" = "xyes"; then
 	   AC_MSG_FAILURE([
-  Could not link test program to Python. Maybe the main Python library has been
-  installed in some non-standard library path. If so, pass it to configure,
-  via the LIBS environment variable.
-  Example: ./configure LIBS="-L/usr/non-standard-path/python/lib"
+  Could not compile a test program against Python.h. Maybe the Python headers
+  have been installed in some non-standard include path. If so, pass it to
+  configure via the PYTHON_CPPFLAGS environment variable.
+  Example: ./configure PYTHON_CPPFLAGS="-I/usr/non-standard-path/python/include"
   ============================================================================
    ERROR!
    You probably have to install the development version of the Python package
-- 
2.55.0

