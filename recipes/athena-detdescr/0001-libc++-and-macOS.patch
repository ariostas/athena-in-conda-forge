+/// The Legendre polynomial P_n(x): std::legendre, or its recurrence where the standard library
+/// has no special mathematical functions (libc++)
+double legendreP(unsigned int n, double x) {
+#ifdef _LIBCPP_VERSION
+  double p0 = 1., p1 = x;
+  if (n == 0) return p0;
+  for (unsigned int k = 1; k < n; ++k) {
+    const double p2 = ((2 * k + 1) * x * p1 - k * p0) / (k + 1);
+    p0 = p1;
+    p1 = p2;
+  }
+  return p1;
+#else
+  return std::legendre(n, x);
+#endif
+}
